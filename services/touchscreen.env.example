# Optional touchscreen-only settings and credential paths.
# Installed to: /etc/sellmate/touchscreen.env (mode 600, root-owned)
# Loaded by sellmate-touchscreen.service in addition to machine.env.
#
# Do not put MACHINE_SHARED_TOKEN here unless needed; prefer machine.env.

FULLSCREEN=true
IDLE_TIMEOUT_SECONDS=90
POLL_INTERVAL_SECONDS=2
POLL_MAX_ATTEMPTS=90
INVENTORY_MAX_AGE_SECONDS=300
INVENTORY_IDLE_REFRESH_SECONDS=120
LOG_LEVEL=INFO
TOUCHSCREEN_DATA_DIR=/home/sambeals/.local/share/sellmate-touchscreen

# Firestore read-only service account for inventory/planogram
GOOGLE_APPLICATION_CREDENTIALS=/etc/sellmate/firestore-reader.json
FIRESTORE_PROJECT_ID=sellmate-bdd22

# Lab/dev only:
# INVENTORY_FIXTURE_PATH=/home/sambeals/pi-touchscreen/fixtures/inventory.json
