# Optional touchscreen-only settings and credential paths.
# Installed to: /etc/sellmate/touchscreen.env (mode 600, root-owned)
# Loaded by sellmate-touchscreen.service in addition to machine.env.
#
# Do not put MACHINE_SHARED_TOKEN here unless needed; prefer machine.env.
# Display rotation / touch calibration: run provisioning/display/install-portrait-display.sh
# (writes /etc/sellmate/display.env + labwc autostart/rc.xml). See docs/DISPLAY.md.

FULLSCREEN=true
IDLE_TIMEOUT_SECONDS=90
POLL_INTERVAL_SECONDS=2
POLL_MAX_ATTEMPTS=90
INVENTORY_MAX_AGE_SECONDS=300
INVENTORY_IDLE_REFRESH_SECONDS=120
LOG_LEVEL=INFO
TOUCHSCREEN_DATA_DIR=/home/sambeals/.local/share/sellmate-touchscreen

# Renter theme package id (folder under THEME_PACKAGES_DIR or bundled themes/)
THEME_ID=sellmate-default
# THEME_PACKAGES_DIR=/etc/sellmate/themes
# Cloud theme sync (polls while on Attract; installs under TOUCHSCREEN_DATA_DIR/themes)
THEME_SYNC_ENABLED=true
THEME_POLL_SECONDS=60
# MACHINE_SHARED_TOKEN is read from /etc/sellmate/machine.env (same as health reporter)

# Firestore read-only service account for inventory/planogram
GOOGLE_APPLICATION_CREDENTIALS=/etc/sellmate/firestore-reader.json
FIRESTORE_PROJECT_ID=sellmate-bdd22

# Qt platform: prefer Wayland on the Pi (also set in the systemd unit).
# Leave unset on macOS. Headless tests use QT_QPA_PLATFORM=offscreen.
# QT_QPA_PLATFORM=wayland;xcb
# WAYLAND_DISPLAY=wayland-0

# Lab/dev only:
# INVENTORY_FIXTURE_PATH=/home/sambeals/pi-touchscreen/fixtures/inventory.json
