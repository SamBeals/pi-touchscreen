# SellMate portrait display provisioning (labwc / Wayland).
# Installed to: /etc/sellmate/display.env (mode 644)
# Sourced by /usr/local/bin/sellmate-apply-portrait-display from labwc autostart.
#
# Physical panel timing is typically 1024x600 landscape HDMI.
# Compositor transform makes the logical desktop portrait (~600x1024).
#
# IMPORTANT: Quote every value (as the installer does with printf %q).
# Touch device names and calibration matrices often contain spaces.

# DRM/wlroots output name from `wlr-randr` (often HDMI-A-1 or HDMI-A-2).
SELLMATE_DISPLAY_OUTPUT='HDMI-A-1'

# wlroots transform for SellMate assembly orientation (default 270).
# Display transform is independent of the touch matrix. Do not change this
# just to "fix" touch — use calibrate-touch.sh instead.
SELLMATE_DISPLAY_TRANSFORM='270'

# Exact Device: name from `libinput list-devices` (Capabilities: touch).
# Example with spaces (must stay quoted):
SELLMATE_TOUCH_DEVICE='yldzkj USB2IIC_CTP_CONTROL'

# libinput calibration matrix — MUST be measured for this controller.
# Generic 90°/270° tables are placeholders only and are inaccurate for
# yldzkj USB2IIC_CTP_CONTROL. Generate with:
#   sudo -E ./provisioning/display/calibrate-touch.sh --apply
# Placeholder (do not ship without measuring):
SELLMATE_TOUCH_CALIBRATION_MATRIX='0.0 1.0 0.0 -1.0 1.0 0.0'
